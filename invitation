.feature-title {

    color:#fff3e8;

    font-size:10px;

    font-weight:800;

    letter-spacing:2px;

    line-height:1.5;

}

.feature-text {

    margin-top:10px;

    color:#cdbeb4;

    font-size:10px;

    line-height:1.7;

}

/* =========================================================
   EVENT PANEL
========================================================= */

.poster-event-panel {

    position:relative;

    z-index:10;

    width:80%;

    margin:
        65px auto 0;

    padding:25px;

    display:grid;

    grid-template-columns:
        repeat(3,1fr);

    align-items:center;

    background:

        linear-gradient(
            135deg,
            rgba(36,7,2,.95),
            rgba(15,2,0,.95)
        );

    border:
        1px solid
        rgba(255,100,25,.75);

    border-radius:22px;

    box-shadow:

        0 0 45px
        rgba(255,40,0,.18),

        inset 0 0 30px
        rgba(255,80,0,.05);

    backdrop-filter:
        blur(10px);

}

.poster-event {

    position:relative;

    text-align:center;

    padding:
        0 18px;

}

.poster-event:not(:last-child)::after {

    content:"";

    position:absolute;

    right:0;

    top:10%;

    height:80%;

    width:1px;

    background:

        linear-gradient(
            transparent,
            rgba(255,157,50,.7),
            transparent
        );

}

.poster-event-icon {

    font-size:28px;

    margin-bottom:8px;

    color:#ff8a22;

    filter:

        drop-shadow(
            0 0 8px
            rgba(255,60,0,.5)
        );

}

.poster-event-label {

    color:#a99b91;

    font-size:8px;

    letter-spacing:3px;

    font-weight:800;

}

.poster-event-value {

    margin-top:7px;

    color:white;

    font-size:12px;

    font-weight:700;

    line-height:1.6;

}

.poster-event-value strong {

    color:#ffd166;

}

/* =========================================================
   FIRE HORIZON
========================================================= */

.fire-horizon {

    position:absolute;

    left:50%;

    bottom:-165px;

    width:1100px;

    height:390px;

    transform:
        translateX(-50%);

    border-radius:
        50%
        50%
        0
        0;

    background:

        radial-gradient(
            ellipse at 50% 5%,
            #fff4b0 0%,
            #ff9e30 3%,
            #ff3b0b 10%,
            #a00e00 25%,
            #280300 52%,
            #060000 75%
        );

    box-shadow:

        0 -10px 60px
        rgba(255,80,0,.5),

        0 -40px 110px
        rgba(255,30,0,.25);

    animation:
        horizonPulse
        4s
        ease-in-out
        infinite
        alternate;

}

.fire-horizon::before {

    content:"";

    position:absolute;

    left:5%;
    right:5%;

    top:60px;

    height:170px;

    border-radius:50%;

    background:

        repeating-linear-gradient(
            95deg,
            rgba(255,170,60,.05) 0 3px,
            transparent 3px 11px
        );

}

@keyframes horizonPulse {

    from {

        filter:
            brightness(.9);

    }

    to {

        filter:
            brightness(1.2);

    }

}

.fire-glow {

    position:absolute;

    left:50%;

    bottom:130px;

    width:250px;

    height:100px;

    transform:
        translateX(-50%);

    border-radius:50%;

    background:

        radial-gradient(
            ellipse,
            rgba(255,235,150,.95),
            rgba(255,81,20,.4),
            transparent 70%
        );

    filter:
        blur(10px);

    animation:
        sunrise
        2s
        ease-in-out
        infinite
        alternate;

}

@keyframes sunrise {

    from {

        transform:
            translateX(-50%)
            scale(.8);

        opacity:.7;

    }

    to {

        transform:
            translateX(-50%)
            scale(1.2);

        opacity:1;

    }

}

/* =========================================================
   POSTER BOTTOM
========================================================= */

.poster-bottom {

    position:absolute;

    z-index:11;

    left:50%;

    bottom:30px;

    transform:
        translateX(-50%);

    width:90%;

    text-align:center;

}

.poster-bottom-script {

    font-family:
        "Allura",
        cursive;

    font-size:
        clamp(
            30px,
            5vw,
            48px
        );

    color:#fff3dc;

    text-shadow:
        0 0 15px #ff4d00;

}

.poster-bottom-line {

    margin-top:10px;

    font-size:9px;

    color:#d7c8be;

    letter-spacing:6px;

}

/* =========================================================
   STANDARD SECTIONS
========================================================= */

section.standard {

    position:relative;

    z-index:2;

    padding:
        120px 7%;

}

.center {

    text-align:center;

}

.section-label {

    color:#ff9d32;

    font-size:9px;

    font-weight:800;

    letter-spacing:5px;

    text-transform:uppercase;

    margin-bottom:18px;

}

.section-title {

    font-family:
        "Cinzel",
        serif;

    font-size:
        clamp(
            40px,
            7vw,
            78px
        );

    text-shadow:
        0 0 30px
        rgba(255,50,0,.15);

}

/* =========================================================
   INVITATION
========================================================= */

.invitation {

    background:

        radial-gradient(
            circle at center,
            rgba(255,50,0,.08),
            transparent 60%
        );

}

.invitation-card {

    position:relative;

    max-width:950px;

    margin:
        60px auto 0;

    padding:
        clamp(
            45px,
            8vw,
            90px
        );

    text-align:center;

    background:
        rgba(255,255,255,.025);

    border:
        1px solid
        rgba(255,80,25,.4);

    overflow:hidden;

    transform-style:
        preserve-3d;

    transition:
        transform .18s ease-out;

    box-shadow:
        0 25px 80px
        rgba(0,0,0,.5);

}

.invitation-card::before {

    content:"";

    position:absolute;

    inset:-2px;

    background:

        conic-gradient(
            from 0deg,
            transparent,
            #ff2400,
            transparent 25%,
            #ff9d32,
            transparent 50%,
            #d60000,
            transparent
        );

    animation:
        spinBorder
        7s
        linear
        infinite;

    z-index:-2;

}

.invitation-card::after {

    content:"";

    position:absolute;

    inset:1px;

    background:#100201;

    z-index:-1;

}

@keyframes spinBorder {

    to {

        transform:
            rotate(360deg);

    }

}

.invitation-card h2 {

    font-family:
        "Cinzel",
        serif;

    font-size:48px;

    color:#ffd166;

    margin-bottom:28px;

    text-shadow:
        0 0 20px
        rgba(255,80,0,.25);

}

.invitation-card p {

    color:#ded0c7;

    font-size:15px;

    line-height:2;

}

.signature {

    margin-top:40px;

    font-family:
        "Allura",
        cursive;

    color:#ff8b30;

    font-size:36px;

    text-shadow:
        0 0 15px #ff3c00;

}

/* =========================================================
   DETAILS
========================================================= */

.details {

    background:

        linear-gradient(
            180deg,
            transparent,
            rgba(255,50,0,.018),
            transparent
        );

}

.details-grid {

    max-width:1100px;

    margin:
        65px auto 0;

    display:grid;

    grid-template-columns:
        repeat(2,1fr);

    gap:20px;

}

.detail {

    position:relative;

    padding:40px;

    background:
        rgba(255,255,255,.025);

    border:
        1px solid
