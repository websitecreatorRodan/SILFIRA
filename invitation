        transform .18s ease-out,

        border-color .4s,

        box-shadow .4s;

}

.detail::before {

    content:"";

    position:absolute;

    top:0;

    left:-100%;

    width:100%;
    height:1px;

    background:

        linear-gradient(
            90deg,
            transparent,
            #ff6a00,
            transparent
        );

    transition:.7s;

}

.detail:hover::before {

    left:100%;

}

.detail:hover {

    border-color:
        rgba(255,85,20,.5);

    box-shadow:

        0 25px 70px
        rgba(0,0,0,.5),

        0 0 30px
        rgba(255,50,0,.08);

}

.detail-icon {

    font-size:28px;

    color:#ff8b22;

    margin-bottom:20px;

    filter:

        drop-shadow(
            0 0 8px
            rgba(255,60,0,.45)
        );

}

.detail h3 {

    color:#ffd166;

    font-size:10px;

    letter-spacing:3px;

    text-transform:uppercase;

    margin-bottom:12px;

}

.detail p {

    color:#e0d6d0;

    font-size:15px;

    line-height:1.8;

}

.venue-map {

    display:inline-flex;

    margin-top:18px;

    padding:
        11px 17px;

    align-items:center;

    gap:8px;

    border:
        1px solid
        rgba(255,100,25,.45);

    color:#ff9d32;

