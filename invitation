
<!DOCTYPE html>
<html lang="en">

<head>

<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<meta name="theme-color" content="#050000">

<title>NARAYANA |  2026</title>

<style>

/* =========================================================
   FONTS
========================================================= */

@import url(
'https://fonts.googleapis.com/css2?family=Cinzel:wght@400;500;600;700;800;900&family=Inter:wght@400;500;600;700;800;900&family=Allura&display=swap'
);

/* =========================================================
   ROOT
========================================================= */

:root {

    --black:#050000;
    --black2:#0b0100;

    --red:#ff1600;
    --red2:#ff3b16;

    --orange:#ff6500;
    --orange2:#ff922b;

    --yellow:#ffd166;
    --gold:#ffbd38;

    --white:#fff8ed;

    --muted:#c7b8ad;

    --mouse-x:50%;
    --mouse-y:50%;

    --scroll-progress:0%;

}

/* =========================================================
   RESET
========================================================= */

* {

    margin:0;
    padding:0;

    box-sizing:border-box;

}

html {

    scroll-behavior:smooth;

}

body {

    min-height:100vh;

    overflow-x:hidden;

    color:white;

    font-family:
        "Inter",
        sans-serif;

    background:

        radial-gradient(
            circle at 50% 0%,
            #3a0800 0%,
            #170300 28%,
            #080000 65%,
            #020000 100%
        );

}

/* =========================================================
   SELECTION
========================================================= */

::selection {

    background:
        rgba(255,75,0,.5);

    color:white;

}

/* =========================================================
   SCROLLBAR
========================================================= */

::-webkit-scrollbar {

    width:7px;

}

::-webkit-scrollbar-track {

    background:#050000;

}

::-webkit-scrollbar-thumb {

    border-radius:20px;

    background:

        linear-gradient(
            var(--red),
            var(--orange),
            var(--yellow)
        );

}

/* =========================================================
   SCROLL PROGRESS
========================================================= */

.scroll-progress {

    position:fixed;

    top:0;
    left:0;

    width:var(--scroll-progress);

    height:4px;

    background:

        linear-gradient(
            90deg,
            #ff0000,
            #ff4d00,
            #ff9d00,
            #ffe08a
        );

    box-shadow:

        0 0 15px #ff3b00,
        0 0 30px #ff6a00;

    z-index:100000;

}

/* =========================================================
   AMBIENT FIRE
========================================================= */

.ambient {

    position:fixed;

    border-radius:50%;

    pointer-events:none;

    filter:blur(120px);

    z-index:-10;

}

.ambient-1 {

    width:700px;
    height:700px;

    top:-450px;
    left:50%;

    transform:
        translateX(-50%);

    background:
        rgba(255,40,0,.25);

    animation:
        fireBreathe
        5s
        ease-in-out
        infinite
        alternate;

}

.ambient-2 {

    width:550px;
    height:550px;

    right:-300px;
    bottom:-250px;

    background:
        rgba(255,91,0,.18);

    animation:
        fireFloat
        8s
        ease-in-out
        infinite
        alternate;

}

.ambient-3 {

    width:500px;
    height:500px;

    left:-300px;
    top:40%;

    background:
        rgba(180,0,0,.18);

    animation:
        fireFloat2
        10s
        ease-in-out
        infinite
        alternate;

}

@keyframes fireBreathe {

    from {

        transform:
            translateX(-50%)
            scale(.75);

        opacity:.4;

    }

    to {

        transform:
            translateX(-50%)
            scale(1.35);

        opacity:1;

    }

}

@keyframes fireFloat {

    to {

        transform:
            translate(
                -100px,
                -130px
            )
            scale(1.25);

    }

}

@keyframes fireFloat2 {

    to {

        transform:
            translate(
                120px,
                100px
            )
            scale(1.3);

    }

}

/* =========================================================
   CURSOR
========================================================= */

.cursor {

    position:fixed;

    width:10px;
    height:10px;

    border-radius:50%;

    background:#fff4d0;

    box-shadow:

        0 0 12px #fff,
        0 0 25px var(--orange),
        0 0 50px var(--red);

    pointer-events:none;

    z-index:100001;

    transform:
        translate(-50%,-50%);

}

.cursor-ring {

    position:fixed;

    width:40px;
    height:40px;

    border:
        1px solid
        rgba(255,117,35,.7);

    border-radius:50%;

    pointer-events:none;

    z-index:100000;

    transform:
        translate(-50%,-50%);

}

/* =========================================================
   MOUSE LIGHT
========================================================= */

body::before {

    content:"";

    position:fixed;

    width:700px;
    height:700px;

    left:var(--mouse-x);
    top:var(--mouse-y);

    transform:
        translate(-50%,-50%);

    border-radius:50%;

    background:

        radial-gradient(
            circle,
            rgba(255,80,0,.08),
            transparent 70%
        );

    pointer-events:none;

    z-index:-4;

}

/* =========================================================
   LOADER
========================================================= */

#loader {

    position:fixed;

    inset:0;

    display:flex;

    flex-direction:column;

    align-items:center;
    justify-content:center;

    background:

        radial-gradient(
            circle,
            #280500,
            #050000 65%
        );

    z-index:999999;

    animation:
        loaderExit
        1s
        ease
        3.3s
        forwards;

}

.loader-fire {

    position:absolute;

    width:260px;
    height:260px;

    border-radius:50%;

    background:

        radial-gradient(
            circle,
            rgba(255,215,100,.18),
            rgba(255,60,0,.12),
            transparent 70%
        );

    filter:blur(10px);

    animation:
        loaderFire
        1.5s
        ease-in-out
        infinite
        alternate;

}

@keyframes loaderFire {

    from {

        transform:scale(.7);

        opacity:.5;

    }

    to {

        transform:scale(1.3);

        opacity:1;

    }

}

.loader-main {

    position:relative;

    font-family:
        "Cinzel",
        serif;

    font-size:
        clamp(
            42px,
            10vw,
            105px
        );

    font-weight:900;

    letter-spacing:14px;

    color:#fff5df;

    text-shadow:

        0 0 15px #ffb000,
        0 0 35px #ff4d00,
        0 0 80px rgba(255,30,0,.7);

    animation:
        loaderIn
        1.6s
        cubic-bezier(.16,1,.3,1);

}

.loader-sub {

    margin-top:18px;

    color:
        var(--orange2);

    font-size:9px;

    letter-spacing:7px;

    text-transform:uppercase;

    opacity:0;

    animation:
        fadeOnly
        1s
        ease
        1.5s
        forwards;

}

.loader-line {

    width:0;

    height:2px;

    margin-top:25px;

    background:

        linear-gradient(
            90deg,
            transparent,
            #ff2100,
            #ffd166,
            #ff2100,
            transparent
        );

    box-shadow:
        0 0 15px #ff4d00;

    animation:
        growLine
        1.5s
        ease
        .5s
        forwards;

}

@keyframes loaderIn {

    from {

        opacity:0;

        transform:
            translateY(35px)
            scale(.5);

        filter:blur(15px);

        letter-spacing:40px;

    }

    to {

        opacity:1;

        transform:
            translateY(0)
            scale(1);

        filter:blur(0);

        letter-spacing:14px;

    }

}

@keyframes fadeOnly {

    to {

        opacity:1;

    }

}

@keyframes growLine {

    to {

        width:320px;

    }

}

@keyframes loaderExit {

    to {

        opacity:0;

        visibility:hidden;

    }

}

/* =========================================================
   GLOBAL EMBERS
========================================================= */

#particles {

    position:fixed;

    inset:0;

    pointer-events:none;

    overflow:hidden;

    z-index:0;

}

.ember {

    position:absolute;

    width:3px;
    height:3px;

    border-radius:50%;

    background:#ffb52e;

    box-shadow:

        0 0 5px #ff6a00,
        0 0 12px #ff2400;

    opacity:0;

    animation:
        emberRise
        linear
        infinite;

}

@keyframes emberRise {

    0% {

        opacity:0;

        transform:
            translate3d(
                0,
                110vh,
                0
            )
            scale(.2);

    }

    10% {

        opacity:1;

    }

    50% {

        transform:
            translate3d(
                var(--dx),
                45vh,
                0
            )
            scale(1);

    }

    85% {

        opacity:.35;

    }

    100% {

        opacity:0;

        transform:
            translate3d(
                calc(
                    var(--dx) * -1
                ),
                -10vh,
                0
            )
            scale(.1);

    }

}

/* =========================================================
   SHOOTING FIRE STARS
========================================================= */

.shooting-star {

    position:fixed;

    width:180px;
    height:2px;

    background:

        linear-gradient(
            90deg,
            transparent,
            #ff7b00,
            #fff2b0
        );

    opacity:0;

    transform:
        rotate(-35deg);

    pointer-events:none;

    z-index:1;

    box-shadow:
        0 0 12px #ff4500;

}

.shooting-star::after {

    content:"";

    position:absolute;

    right:0;

    width:7px;
    height:7px;

    border-radius:50%;

    background:white;

    box-shadow:

        0 0 15px white,
        0 0 30px #ff4d00;

}

.s1 {

    top:15%;
    left:5%;

    animation:
        shoot
        7s
        linear
        3s
        infinite;

}

.s2 {

    top:35%;
    left:75%;

    animation:
        shoot
        10s
        linear
        6s
        infinite;

}

.s3 {

    top:8%;
    left:50%;

    animation:
        shoot
        13s
        linear
        9s
        infinite;

}

@keyframes shoot {

    0% {

        opacity:0;

        transform:
            translate(0,0)
            rotate(-35deg)
            scale(.3);

    }

    5% {

        opacity:1;

    }

    15% {

        opacity:0;

        transform:
            translate(
                500px,
                280px
            )
            rotate(-35deg)
            scale(1);

    }

    100% {

        opacity:0;

    }

}

/* =========================================================
   NAVIGATION
========================================================= */

nav {

    position:fixed;

    top:0;
    left:0;

    width:100%;

    padding:
        21px 7%;

    display:flex;

    align-items:center;

    justify-content:space-between;

    background:
        rgba(8,0,0,.4);

    backdrop-filter:
        blur(20px);

    border-bottom:
        1px solid
        rgba(255,70,0,.1);

    z-index:100;

    transition:
        padding .45s,
        background .45s;

}

nav.scrolled {

    padding:
        13px 7%;

    background:
        rgba(8,0,0,.9);

    border-bottom-color:
        rgba(255,75,0,.25);

}

.logo {

    color:#fff5e0;

    font-family:
        "Cinzel",
        serif;

    font-size:20px;

    font-weight:900;

    letter-spacing:4px;

    text-shadow:
        0 0 15px #ff4d00;

}

.nav-links {

    display:flex;

    list-style:none;

    gap:32px;

}

.nav-links a {

    position:relative;

    color:#e6d5ca;

    text-decoration:none;

    font-size:9px;

    letter-spacing:3px;

    text-transform:uppercase;

    transition:.3s;

}

.nav-links a::after {

    content:"";

    position:absolute;

    left:50%;

    bottom:-10px;

    width:0;

    height:2px;

    background:

        linear-gradient(
            90deg,
            #ff1e00,
            #ffbd38
        );

    transform:
        translateX(-50%);

    transition:.35s;

    box-shadow:
        0 0 10px #ff4500;

}

.nav-links a:hover,
.nav-links a.active {

    color:#ffd166;

}

.nav-links a:hover::after,
.nav-links a.active::after {

    width:100%;

}

/* =========================================================
   HERO
========================================================= */

.hero {

    position:relative;

    min-height:100vh;

    display:flex;

    align-items:center;

    justify-content:center;

    text-align:center;

    padding:
        130px 20px 80px;

    overflow:hidden;

}

.hero::before {

    content:"";

    position:absolute;

    width:760px;
    height:760px;

    border:
        1px solid
        rgba(255,62,0,.25);

    border-radius:50%;

    box-shadow:
        0 0 80px rgba(255,45,0,.08);

    animation:
        rotate
        25s
        linear
        infinite;

}

.hero::after {

    content:"";

    position:absolute;

    width:520px;
    height:520px;

    border:
        1px solid
        rgba(255,179,52,.16);

    border-radius:50%;

    animation:
        reverseRotate
        18s
        linear
        infinite;

}

@keyframes rotate {

    to {

        transform:
            rotate(360deg);

    }

}

@keyframes reverseRotate {

    to {

        transform:
            rotate(-360deg);

    }

}

.hero-fire {

    position:absolute;

    width:500px;
    height:500px;

    border-radius:50%;

    background:

        radial-gradient(
            circle,
            rgba(255,155,30,.12),
            rgba(255,30,0,.08),
            transparent 70%
        );

    filter:blur(20px);

    animation:
        heroFire
        3s
        ease-in-out
        infinite
        alternate;

}

@keyframes heroFire {

    from {

        transform:scale(.8);

        opacity:.5;

    }

    to {

        transform:scale(1.25);

        opacity:1;

    }

}

.hero-content {

    position:relative;

    z-index:3;

    transition:
        transform .15s ease-out;

}

.badge {

    display:inline-flex;

    align-items:center;

    gap:9px;

    padding:
        10px 20px;

    border:
        1px solid
        rgba(255,115,35,.55);

    border-radius:100px;

    color:#ffbf5d;

    font-size:9px;

    font-weight:800;

    letter-spacing:4px;

    text-transform:uppercase;

    background:
        rgba(255,40,0,.04);

    box-shadow:

        inset 0 0 20px
        rgba(255,60,0,.04),

        0 0 20px
        rgba(255,50,0,.1);

    animation:
        fadeUp
        1s
        ease
        3.4s
        both;

}

.badge::before {

    content:"";

    width:7px;
    height:7px;

    border-radius:50%;

    background:#ff8b22;

    box-shadow:

        0 0 8px #ff3c00,
        0 0 20px #ff7300;

    animation:
        pulseDot
        1.2s
        infinite;

}

@keyframes pulseDot {

    50% {

        transform:
            scale(1.8);

    }

}

.hero h1 {

    margin-top:32px;

    font-family:
        "Cinzel",
        serif;

    font-size:
        clamp(
            60px,
            14vw,
            175px
        );

    font-weight:900;

    line-height:.72;

    letter-spacing:-6px;

    animation:
        heroIn
        1.7s
        cubic-bezier(.16,1,.3,1)
        3.7s
        both;

    text-shadow:

        0 0 15px
        rgba(255,80,0,.2),

        0 0 45px
        rgba(255,30,0,.15);

}

.hero-event {

    display:block;

    margin-top:32px;

    font-family:
        "Cinzel",
        serif;

    font-size:.36em;

    font-weight:700;

    letter-spacing:14px;

    background:

        linear-gradient(
            90deg,
            #ff2a00,
            #ffb52d,
            #fff0a0,
            #ff6a00
        );

    -webkit-background-clip:text;

    background-clip:text;

    -webkit-text-fill-color:transparent;

    filter:
        drop-shadow(
            0 0 12px
            rgba(255,70,0,.55)
        );

    animation:
        fireText
        2.5s
        ease-in-out
        infinite
        alternate;

}

.hero-year {

    display:block;

    margin-top:17px;

    font-size:.17em;

    letter-spacing:10px;

    font-weight:500;

    color:#ffd166;

}

@keyframes fireText {

    from {

        filter:
            drop-shadow(
                0 0 8px
                rgba(255,40,0,.35)
            );

    }

    to {

        filter:
            drop-shadow(
                0 0 25px
                rgba(255,90,0,.75)
            );

    }

}

.hero-description {

    max-width:650px;

    margin:
        50px auto 0;

    color:var(--muted);

    font-size:14px;

    line-height:2;

    animation:
        fadeUp
        1s
        ease
        5s
        both;

}

@keyframes heroIn {

    from {

        opacity:0;

        transform:
            perspective(900px)
            rotateX(70deg)
            translateY(110px)
            scale(.6);

        filter:blur(15px);

    }

    to {

        opacity:1;

        transform:
            perspective(900px)
            rotateX(0)
            translateY(0)
            scale(1);

        filter:blur(0);

    }

}

@keyframes fadeUp {

    from {

        opacity:0;

        transform:
            translateY(30px);

    }

    to {

        opacity:1;

        transform:
            translateY(0);

    }

}

/* =========================================================
   SCROLL INDICATOR
========================================================= */

.scroll-indicator {

    position:absolute;

    left:50%;

    bottom:28px;

    transform:
        translateX(-50%);

    display:flex;

    flex-direction:column;

    align-items:center;

    gap:9px;

    z-index:10;

    color:#c7a99a;

    animation:
        scrollEntrance
        1.2s
        ease
        5.5s
        both;

}

.scroll-text {

    font-size:7px;

    font-weight:700;

    letter-spacing:4px;

    text-transform:uppercase;

    white-space:nowrap;

    opacity:.75;

}

.scroll-mouse {

    position:relative;

    width:22px;
    height:34px;

    border:
        1px solid
        rgba(255,117,35,.7);

    border-radius:14px;

    box-shadow:

        0 0 15px
        rgba(255,60,0,.18),

        inset 0 0 10px
        rgba(255,90,0,.08);

    animation:
        mouseFloat
        2.2s
        ease-in-out
        infinite;

}

.scroll-wheel {

    position:absolute;

    left:50%;
    top:6px;

    width:3px;
    height:7px;

    border-radius:5px;

    background:#ffd166;

    box-shadow:

        0 0 8px #ffd166,
        0 0 15px #ff6a00;

    transform:
        translateX(-50%);

    animation:
        wheelScroll
        1.7s
        ease-in-out
        infinite;

}

.scroll-arrow {

    color:#ff9d32;

    font-size:14px;

    text-shadow:
        0 0 12px #ff4d00;

    animation:
        arrowBounce
        1.5s
        ease-in-out
        infinite;

}

@keyframes scrollEntrance {

    from {

        opacity:0;

        transform:
            translate(-50%,30px);

    }

    to {

        opacity:1;

        transform:
            translate(-50%,0);

    }

}

@keyframes mouseFloat {

    0%,100% {

        transform:
            translateY(0);

    }

    50% {

        transform:
            translateY(5px);

    }

}

@keyframes wheelScroll {

    0% {

        opacity:0;

        transform:
            translate(-50%,0);

    }

    20% {

        opacity:1;

    }

    70% {

        opacity:1;

        transform:
            translate(-50%,11px);

    }

    100% {

        opacity:0;

        transform:
            translate(-50%,15px);

    }

}

@keyframes arrowBounce {

    0%,100% {

        transform:
            translateY(0);

        opacity:.55;

    }

    50% {

        transform:
            translateY(6px);

        opacity:1;

    }

}

/* =========================================================
   POSTER SECTION
========================================================= */

.poster-section {

    position:relative;

    padding:
        120px 20px 150px;

    overflow:hidden;

    background:

        radial-gradient(
            circle at 50% 30%,
            rgba(255,45,0,.13),
            transparent 50%
        );

}

.poster-heading {

    text-align:center;

    margin-bottom:60px;

}

.poster-heading small {

    display:block;

    color:#ff9d32;

    font-size:9px;

    font-weight:800;

    letter-spacing:5px;

    text-transform:uppercase;

    margin-bottom:15px;

}

.poster-heading h2 {

    font-family:
        "Cinzel",
        serif;

    font-size:
        clamp(
            42px,
            7vw,
            78px
        );

    text-shadow:
        0 0 30px
        rgba(255,60,0,.2);

}

/* =========================================================
   CINEMATIC POSTER
========================================================= */

.cinematic-poster {

    position:relative;

    width:min(
        1060px,
        94vw
    );

    min-height:1450px;

    margin:auto;

    overflow:hidden;

    border-radius:25px;

    background:

        radial-gradient(
            ellipse at 50% 12%,
            rgba(255,145,20,.32),
            transparent 18%
        ),

        radial-gradient(
            ellipse at 30% 35%,
            rgba(255,35,0,.18),
            transparent 35%
        ),

        radial-gradient(
            ellipse at 75% 55%,
            rgba(190,0,0,.2),
            transparent 40%
        ),

        linear-gradient(
            180deg,
            #210300 0%,
            #100100 30%,
            #090000 65%,
            #030000 100%
        );

    border:
        1px solid
        rgba(255,100,30,.75);

    box-shadow:

        0 45px 120px
        rgba(0,0,0,.85),

        0 0 100px
        rgba(255,45,0,.18);

    transform-style:
        preserve-3d;

    transition:
        transform .18s ease-out;

}

/* =========================================================
   FIERY FRAME
========================================================= */

.cinematic-poster::before {

    content:"";

    position:absolute;

    inset:-5px;

    background:

        conic-gradient(
            from 0deg,
            transparent,
            #ff1700,
            transparent 12%,
            #ff8a00,
            transparent 25%,
            #ffcf55,
            transparent 40%,
            #d60000,
            transparent 58%,
            #ff5a00,
            transparent 75%,
            #ff1e00,
            transparent
        );

    animation:
        posterFrame
        7s
        linear
        infinite;

    z-index:-1;

    filter:blur(2px);

}

@keyframes posterFrame {

    to {

        transform:
            rotate(360deg);

    }

}

/* =========================================================
   POSTER FIRE GLOW
========================================================= */

.poster-fire {

    position:absolute;

    left:50%;
    top:20%;

    width:500px;
    height:500px;

    transform:
        translateX(-50%);

    border-radius:50%;

    background:

        radial-gradient(
            circle,
            rgba(255,166,50,.18),
            rgba(255,30,0,.1),
            transparent 70%
        );

    filter:blur(25px);

    animation:
        posterFirePulse
        4s
        ease-in-out
        infinite
        alternate;

}

@keyframes posterFirePulse {

    from {

        transform:
            translateX(-50%)
            scale(.75);

        opacity:.5;

    }

    to {

        transform:
            translateX(-50%)
            scale(1.3);

        opacity:1;

    }

}

/* =========================================================
   POSTER EMBERS
========================================================= */

.poster-embers {

    position:absolute;

    inset:0;

    overflow:hidden;

}

.poster-embers span {

    position:absolute;

    width:3px;
    height:3px;

    border-radius:50%;

    background:#ffd166;

    box-shadow:

        0 0 8px #ff7b00,
        0 0 18px #ff2600;

    animation:
        posterEmber
        4s
        linear
        infinite;

}

.poster-embers span:nth-child(1) {

    left:8%;
    bottom:10%;

}

.poster-embers span:nth-child(2) {

    left:17%;
    bottom:4%;

    animation-delay:.4s;

}

.poster-embers span:nth-child(3) {

    left:29%;
    bottom:15%;

    animation-delay:1s;

}

.poster-embers span:nth-child(4) {

    left:40%;
    bottom:5%;

    animation-delay:1.6s;

}

.poster-embers span:nth-child(5) {

    left:52%;
    bottom:13%;

    animation-delay:.8s;

}

.poster-embers span:nth-child(6) {

    left:64%;
    bottom:3%;

    animation-delay:2s;

}

.poster-embers span:nth-child(7) {

    left:75%;
    bottom:12%;

    animation-delay:1.2s;

}

.poster-embers span:nth-child(8) {

    left:88%;
    bottom:6%;

    animation-delay:2.5s;

}

.poster-embers span:nth-child(9) {

    left:93%;
    bottom:20%;

    animation-delay:.6s;

}

.poster-embers span:nth-child(10) {

    left:22%;
    bottom:25%;

    animation-delay:2.2s;

}

@keyframes posterEmber {

    0% {

        opacity:0;

        transform:
            translateY(0)
            scale(.3);

    }

    20% {

        opacity:1;

    }

    100% {

        opacity:0;

        transform:
            translate(
                30px,
                -500px
            )
            scale(.05);

    }

}

/* =========================================================
   SPARK CORE
========================================================= */

.poster-sparks {

    position:absolute;

    left:50%;
    top:29%;

    width:5px;
    height:5px;

    border-radius:50%;

    background:#fff0aa;

    box-shadow:

        0 0 8px #fff,
        0 0 20px #ff6a00;

    animation:
        sparkCore
        2.5s
        ease-in-out
        infinite;

}

.poster-sparks::before,
.poster-sparks::after {

    content:"";

    position:absolute;

    inset:-120px;

    background:

        radial-gradient(
            circle,
            #ffbd38 0 2px,
            transparent 3px
        );

    background-size:
        37px 37px;

    opacity:.4;

    animation:
        sparkRotate
        5s
        linear
        infinite;

}

.poster-sparks::after {

    inset:-180px;

    opacity:.2;

    animation-duration:8s;

    animation-direction:reverse;

}

@keyframes sparkCore {

    50% {

        transform:scale(2);

        box-shadow:

            0 0 20px #fff,
            0 0 50px #ff3b00;

    }

}

@keyframes sparkRotate {

    to {

        transform:
            rotate(360deg);

    }

}

/* =========================================================
