/* =========================================================
   COUNTDOWN
========================================================= */

.countdown-section {

    background:

        radial-gradient(
            circle at center,
            #320800,
            #110100 55%,
            #050000
        );

    text-align:center;

    overflow:hidden;

}

.countdown {

    margin-top:60px;

    display:flex;

    justify-content:center;

    gap:15px;

    flex-wrap:wrap;

}

.time {

    min-width:125px;

    padding:
        30px 20px;

    background:
        rgba(0,0,0,.35);

    border:
        1px solid
        rgba(255,90,20,.3);

    transition:.5s;

}

.time:hover {

    transform:
        translateY(-10px)
        scale(1.04);

    border-color:#ff6a00;

    box-shadow:
        0 20px 55px
        rgba(255,50,0,.2);

}

.time strong {

    display:block;

    font-family:
        "Cinzel",
        serif;

    font-size:58px;

    color:#ffd166;

    text-shadow:
        0 0 20px #ff4d00;

}

.time strong.changed {

    animation:
        countdownFlash
        .5s
        ease;

}

@keyframes countdownFlash {

    0% {

        opacity:.15;

        transform:
            translateY(-18px)
            rotateX(70deg);

    }

    60% {

        opacity:1;

        transform:
            translateY(0)
            rotateX(0);

    }

    100% {

        transform:
            scale(1);

    }

}

.time span {

    display:block;

    margin-top:10px;

    color:#a99a90;

    font-size:8px;

    font-weight:800;

    letter-spacing:3px;

    text-transform:uppercase;

}

/* =========================================================
   FOOTER
========================================================= */

footer {

    padding:
        60px 7%;

    text-align:center;

    border-top:
        1px solid
        rgba(255,70,0,.12);

    color:#75665d;

    font-size:9px;

    letter-spacing:2px;

}

footer strong {

    color:#ff9d32;

    font-size:13px;

    letter-spacing:5px;

    text-shadow:
        0 0 15px
        rgba(255,50,0,.4);

}

/* =========================================================
   REVEAL
========================================================= */

.reveal {

    opacity:0;

    transform:
        translateY(55px)
        scale(.97);

    filter:blur(7px);

    transition:

        opacity 1s ease,

        transform 1.1s
        cubic-bezier(.16,1,.3,1),

        filter 1s ease;

}

.reveal.visible {

